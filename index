   {no:"5-6", text:"기존 고객에게 노동법 개정 사항이나 지원금 정보를 정기적으로 안내합니까?",
    subs:[["방법 / 주기","text"]],
    purpose:"이미 하고 있다면 뉴스레터·블로그로 확장하기 쉽습니다."}
  ]},
 {id:"s6", title:"6부. 실행 역량과 자원", intro:"누가, 얼마의 예산으로, 어디까지 직접 할 수 있는지 확인합니다.",
  q:[
   {no:"6-1", text:"디지털 전환 업무의 내부 담당자와 최종 의사결정자는 누구입니까?",
    purpose:"담당자가 없으면 대표가 병목이 됩니다. 착수 전에 지정을 요청합니다."},
   {no:"6-2", text:"초기 구축 예산과 월 운영 예산은 어느 정도 생각하십니까?",
    subs:[["초기 예산","만원"],["월 운영 예산","만원"],["정부 지원사업(비대면 바우처 등) 활용 의향","text"]],
    purpose:"홈페이지 방식(정적 페이지 / 제작 업체)과 광고 여부를 결정합니다."},
   {no:"6-3", text:"담당자의 디지털 활용 수준은 어느 정도입니까?",
    check:["스마트플레이스 직접 관리 가능","블로그 직접 게시 가능","간단한 웹 편집 가능","모두 어려움"],
    purpose:"인계 후 자체 운영 가능성을 판단합니다."},
   {no:"6-4", text:"내부에서 직접 운영할 부분과 외부에 맡길 부분을 어떻게 나누고 싶습니까?",
    purpose:"12주 계획의 역할 분담 기준입니다."}
  ]},
 {id:"s7", title:"7부. 목표와 성과 기준", intro:"12주 계획의 종착점과 측정 지표를 고객의 말로 받아 적습니다.",
  q:[
   {no:"7-1", text:"12주 뒤 어떤 상태가 되어 있기를 바랍니까?",
    purpose:"실행 계획의 종착점입니다. 구체적인 문장으로 받아 적습니다."},
   {no:"7-2", text:"다음 항목의 우선순위를 매겨 주십시오. (1이 가장 높음)",
    rank:["신규 고객 확보","기존 고객 관리·재계약","업무 효율화","브랜드·신뢰도 제고"],
    purpose:"우선순위에 따라 채널 배분이 달라집니다."},
   {no:"7-3", text:"성과를 무엇으로 판단하시겠습니까?",
    check:["월 신규 문의 수","검색 노출 순위","자문 계약 수","기타"],
    purpose:"3개월 KPI 표에 그대로 반영합니다."},
   {no:"7-4", text:"가장 걱정되는 점은 무엇입니까?",
    check:["시간 부족","비용","효과 불확실","규정 위반","기타"],
    purpose:"장애 요인을 미리 파악하여 계획에 대응책을 넣습니다."},
   {no:"7-5", text:"1년 뒤 법인의 모습(고객 수, 인원, 특화 분야)은 어떻게 그리고 계십니까?",
    purpose:"장기 방향과 12주 계획의 정합성을 확인합니다."}
  ]}
];

const MEMO = ["네이버 검색 결과 확인 내용","경쟁 노무법인 3곳 노출 현황","예상 병목(진단도구 결과와 대조)","즉시 조치 항목(면담 당일)","후속 확인 필요 사항"];

/* ===================== 렌더링 ===================== */
const KEY = "chiyu_dx_intake_v1";
let data = JSON.parse(localStorage.getItem(KEY) || "{}");
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function inputEl(id, kind, cls){
  const v = data[id] ?? "";
  if (kind === "textarea") return `<textarea id="${id}" data-k="${id}">${esc(v)}</textarea>`;
  return `<input type="text" id="${id}" data-k="${id}" class="${cls||""}" value="${esc(v)}">`;
}

function render(){
  let h = `<section id="s0"><h2>기본 정보</h2><div class="grid">`;
  INFO.forEach(([label, def], i) => {
    const id = "info_" + i;
    if (typeof def === "string" && def.startsWith("__select__")) {
      const opts = def.split(":")[1].split("|");
      const v = data[id] ?? "";
      h += `<div class="field"><label>${label}</label><select data-k="${id}"><option value="">선택</option>${opts.map(o=>`<option ${v===o?"selected":""}>${o}</option>`).join("")}</select></div>`;
    } else {
      if (data[id] === undefined && def) data[id] = def;
      h += `<div class="field"><label>${label}</label>${inputEl(id,"text")}</div>`;
    }
  });
  h += `</div></section>`;

  SECTIONS.forEach(sec => {
    h += `<section id="${sec.id}"><h2>${sec.title}</h2><p class="intro">${sec.intro}</p>`;
    sec.q.forEach(q => {
      const base = "q_" + q.no;
      h += `<div class="q"><div class="no">${q.no}</div><div>`;
      h += `<p class="text">${q.text}</p>`;
      if (q.check) {
        h += `<div class="check">` + q.check.map((c,i)=>{
          const id = `${base}_c${i}`;
          return `<label><input type="checkbox" data-k="${id}" ${data[id]?"checked":""}>${c}</label>`;
        }).join("") + `</div>`;
      }
      if (q.rank) {
        h += `<div class="rank">` + q.rank.map((r,i)=>{
          const id = `${base}_r${i}`; const v = data[id] ?? "";
          return `<div><select data-k="${id}"><option value="">-</option>${[1,2,3,4].map(n=>`<option ${String(v)===String(n)?"selected":""}>${n}</option>`).join("")}</select>${r}</div>`;
        }).join("") + `</div>`;
      }
      if (q.subs) {
        h += `<div class="subs">` + q.subs.map(([label,unit],i)=>{
          const id = `${base}_s${i}`;
          if (unit === "text") return `<div class="sub"><span>${label}</span>${inputEl(id,"text","wide")}</div>`;
          return `<div class="sub"><span>${label}</span>${inputEl(id,"text")}<span>${unit}</span></div>`;
        }).join("") + `</div>`;
      }
      h += inputEl(base + "_a", "textarea");
      h += `</div><div class="purpose">${q.purpose}</div></div>`;
    });
    h += `</section>`;
  });

  h += `<section id="s8" class="memo"><h2>컨설턴트 관찰 메모</h2>`;
  MEMO.forEach((m,i)=>{ h += `<div class="field"><label>${m}</label>${inputEl("memo_"+i,"textarea")}</div>`; });
  h += `</section>`;
  document.getElementById("main").innerHTML = h;

  document.getElementById("nav").innerHTML =
    `<a href="#s0">기본 정보</a>` +
    SECTIONS.map(s=>`<a href="#${s.id}" data-sec="${s.id}">${s.title.replace(/\. .*$/,"")} <span class="cnt"></span></a>`).join("") +
    `<a href="#s8">관찰 메모</a>`;

  document.querySelectorAll("textarea").forEach(autosize);
  updateStatus();
}

function autosize(t){ t.style.height="auto"; t.style.height = Math.max(64, t.scrollHeight) + "px"; }

function updateStatus(){
  let total = 0, done = 0;
  SECTIONS.forEach(sec => {
    let sd = 0;
    sec.q.forEach(q => {
      total++;
      const base = "q_" + q.no;
      const answered = Object.keys(data).some(k => k.startsWith(base) && data[k] !== "" && data[k] !== false);
      if (answered) { done++; sd++; }
    });
    const a = document.querySelector(`nav a[data-sec="${sec.id}"]`);
    if (a) { a.querySelector(".cnt").textContent = `${sd}/${sec.q.length}`; a.classList.toggle("done", sd === sec.q.length); }
  });
  document.getElementById("status").textContent = `답변 ${done} / ${total} · 자동 저장됨`;
}

document.addEventListener("input", e => {
  const k = e.target.dataset.k; if (!k) return;
  data[k] = e.target.type === "checkbox" ? e.target.checked : e.target.value;
  localStorage.setItem(KEY, JSON.stringify(data));
  if (e.target.tagName === "TEXTAREA") autosize(e.target);
  updateStatus();
});

/* ===================== 저장 / 불러오기 ===================== */
function fileName(ext){
  const d = new Date(), pad = n => String(n).padStart(2,"0");
  return `치유노무법인_문진표_${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}.${ext}`;
}
function download(name, text, type){
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], {type}));
  a.download = name; a.click(); URL.revokeObjectURL(a.href);
}
function exportJSON(){ download(fileName("json"), JSON.stringify(data, null, 2), "application/json"); }
function importJSON(input){
  const f = input.files[0]; if (!f) return;
  const r = new FileReader();
  r.onload = () => {
    try { data = JSON.parse(r.result); localStorage.setItem(KEY, JSON.stringify(data)); render(); }
    catch { alert("JSON 파일을 읽을 수 없습니다. 이 도구에서 저장한 파일인지 확인해 주십시오."); }
    input.value = "";
  };
  r.readAsText(f);
}
function exportText(){
  let out = "치유 노무법인 디지털 전환 문진표\n\n[기본 정보]\n";
  INFO.forEach(([l], i) => { if (data["info_"+i]) out += `${l}: ${data["info_"+i]}\n`; });
  SECTIONS.forEach(sec => {
    out += `\n[${sec.title}]\n`;
    sec.q.forEach(q => {
      const base = "q_" + q.no; let lines = [];
      if (q.check) q.check.forEach((c,i)=>{ if (data[`${base}_c${i}`]) lines.push(c); });
      if (q.rank) q.rank.forEach((r,i)=>{ if (data[`${base}_r${i}`]) lines.push(`${r}: ${data[`${base}_r${i}`]}`); });
      if (q.subs) q.subs.forEach(([l,u],i)=>{ const v = data[`${base}_s${i}`]; if (v) lines.push(`${l}: ${v}${u==="text"?"":u}`); });
      if (data[base+"_a"]) lines.push(data[base+"_a"]);
      if (lines.length) out += `${q.no} ${q.text}\n  - ${lines.join("\n  - ")}\n`;
    });
  });
  out += "\n[컨설턴트 관찰 메모]\n";
  MEMO.forEach((m,i)=>{ if (data["memo_"+i]) out += `${m}: ${data["memo_"+i]}\n`; });
  const w = window.open("", "_blank");
  w.document.write(`<title>문진표 텍스트</title><pre style="white-space:pre-wrap;font-family:inherit;padding:20px;line-height:1.6">${esc(out)}</pre>`);
}
function resetAll(){
  if (!confirm("입력한 내용을 모두 지웁니다. 먼저 '파일 저장'으로 백업하셨습니까?")) return;
  data = {}; localStorage.removeItem(KEY); render();
}
window.addEventListener("beforeprint", () => document.querySelectorAll("textarea").forEach(autosize));
render();
</script>
</body>
</html>
