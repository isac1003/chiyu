<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>치유 노무법인 디지털 전환 문진표</title>
<style>
  :root{
    --navy:#1F3A5F; --ink:#26303B; --muted:#6B7480; --line:#D7DCE3;
    --fill:#EEF1F5; --paper:#FFFFFF; --bg:#F6F7F9; --warn:#A24A1F; --ok:#2E7D5B;
  }
  *{box-sizing:border-box}
  html{font-size:15px}
  body{margin:0;background:var(--bg);color:var(--ink);
       font-family:"Pretendard","Malgun Gothic","Apple SD Gothic Neo","Noto Sans KR",sans-serif;line-height:1.55}
  a{color:var(--navy)}
  header{background:var(--navy);color:#fff;padding:22px 28px}
  header h1{margin:0;font-size:1.35rem;font-weight:700;letter-spacing:-.01em}
  header p{margin:6px 0 0;font-size:.9rem;opacity:.85}
  .toolbar{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--line);
           padding:10px 28px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .toolbar .spacer{flex:1}
  .toolbar .status{font-size:.85rem;color:var(--muted)}
  button{font:inherit;font-size:.88rem;padding:7px 13px;border-radius:6px;border:1px solid var(--line);
         background:var(--paper);color:var(--ink);cursor:pointer}
  button:hover{background:var(--fill)}
  button.primary{background:var(--navy);border-color:var(--navy);color:#fff}
  button.primary:hover{background:#17304f}
  button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--navy);outline-offset:1px}
  .layout{display:grid;grid-template-columns:230px 1fr;gap:0;max-width:1180px;margin:0 auto}
  nav{position:sticky;top:52px;align-self:start;padding:22px 16px;height:calc(100vh - 52px);overflow:auto}
  nav a{display:block;padding:7px 10px;border-radius:6px;text-decoration:none;font-size:.9rem;color:var(--ink)}
  nav a:hover{background:var(--fill)}
  nav a .cnt{float:right;font-size:.78rem;color:var(--muted)}
  nav a.done .cnt{color:var(--ok)}
  main{padding:24px 28px 80px;min-width:0}
  section{background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:20px 24px;margin-bottom:22px}
  section h2{margin:0 0 4px;font-size:1.12rem;color:var(--navy)}
  section .intro{margin:0 0 14px;font-size:.9rem;color:var(--muted)}
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px 18px}
  .field label{display:block;font-size:.82rem;color:var(--muted);margin-bottom:3px}
  input[type=text],input[type=number],textarea,select{width:100%;font:inherit;padding:7px 9px;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink)}
  textarea{min-height:64px;resize:vertical;overflow:hidden}
  .q{display:grid;grid-template-columns:56px 1fr 260px;gap:0 16px;padding:16px 0;border-top:1px solid var(--line)}
  .q:first-of-type{border-top:0}
  .q .no{font-weight:700;color:var(--navy);padding-top:2px}
  .q .text{font-weight:600;margin:0 0 8px}
  .q .subs{margin:0 0 8px;display:grid;gap:6px}
  .q .sub{display:flex;align-items:center;gap:8px;font-size:.88rem}
  .q .sub input[type=text]{width:90px;padding:4px 7px}
  .q .sub input.wide{flex:1;width:auto}
  .q .purpose{font-size:.82rem;color:var(--muted);border-left:3px solid var(--fill);padding-left:10px}
  .q .purpose b{color:var(--warn);font-weight:600}
  .q .check{display:flex;flex-wrap:wrap;gap:6px 16px;margin:0 0 8px;font-size:.9rem}
  .q .check label{display:flex;align-items:center;gap:5px}
  .rank{display:grid;gap:6px;margin-bottom:8px}
  .rank div{display:flex;align-items:center;gap:8px;font-size:.9rem}
  .rank select{width:64px}
  .memo textarea{min-height:80px}
  .foot{color:var(--muted);font-size:.82rem;text-align:center;padding:20px}
  @media (max-width:900px){
    .layout{grid-template-columns:1fr} nav{display:none}
    .q{grid-template-columns:44px 1fr} .q .purpose{grid-column:2;margin-top:8px;border-left:0;padding-left:0}
    .grid{grid-template-columns:1fr}
  }
  @media print{
    @page{size:A4;margin:14mm}
    body{background:#fff;font-size:10.5pt}
    header{background:none;color:#000;padding:0 0 8px;border-bottom:2px solid #000}
    header p{opacity:1;color:#333}
    .toolbar,nav,.foot,.hide-print{display:none!important}
    .layout{display:block;max-width:none}
    main{padding:0}
    section{border:0;padding:12px 0;margin:0;break-inside:auto}
    section h2{font-size:12pt}
    .q{grid-template-columns:40px 1fr 190px;break-inside:avoid;padding:8px 0}
    input,textarea,select{border:1px solid #bbb;background:#fff;color:#000;font-size:10pt}
    textarea{min-height:36px}
    .q .purpose{font-size:8.5pt;color:#444}
  }
</style>
</head>
